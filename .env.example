# Copy to .env and fill in values:  cp .env.example .env

# ---------- LLM (agent brain) ----------
# gemini | groq
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Tried in order; the next one is used when a model is overloaded
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
# Optional fallback provider: https://console.groq.com/keys
GROQ_API_KEY=

# ---------- Embeddings (local, via Ollama) ----------
# Install model once:  ollama pull nomic-embed-text
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------- PostgreSQL ----------
POSTGRES_DB=solution_platform
POSTGRES_USER=directus
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ---------- Directus ----------
DIRECTUS_PORT=8055
DIRECTUS_PUBLIC_URL=http://localhost:8055
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
DIRECTUS_KEY=
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
# Static token for the agent service account (created by the bootstrap script)
DIRECTUS_AGENT_TOKEN=

# ---------- Agent service ----------
AGENT_SERVICE_PORT=8000
AGENT_SERVICE_URL=http://agent-service:8000
# Shared secret between Directus and the agent service
AGENT_SERVICE_SECRET=
